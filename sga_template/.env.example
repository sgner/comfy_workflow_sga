# ============================================================
# SGA-Template 环境变量配置
# 复制此文件为 .env 并填写你的配置
# .env 文件中的值会覆盖系统环境变量
# ============================================================

# ------------------------------------------------------------
# LLM 供应商配置（默认供应商）
# ------------------------------------------------------------
# 供应商名称：anthropic / openai / deepseek / zhipu / moonshot / qwen
LLM_PROVIDER=anthropic

# API 密钥（必填）
LLM_API_KEY=sk-xxx

# Anthropic 专用（当 LLM_PROVIDER=anthropic 时，也可使用此变量）
# ANTHROPIC_API_KEY=sk-ant-xxx

# API 基础 URL（可选，默认根据供应商自动设置）
# LLM_BASE_URL=https://api.deepseek.com/v1

# 默认模型（可选，默认根据供应商自动设置）
# LLM_MODEL=deepseek-chat

# 最大生成 Token 数（可选）
# LLM_MAX_TOKENS=4096

# 温度参数（可选，0.0 - 1.0）
# LLM_TEMPERATURE=0.7

# 重试次数（可选，默认 2）
# LLM_RETRIES=2

# 重试延迟（毫秒，可选，默认 1000）
# LLM_RETRY_DELAY=1000

# 额外请求头（JSON 格式，可选）
# LLM_EXTRA_HEADERS={"X-Custom-Header":"value"}

# ------------------------------------------------------------
# 多供应商配置
# ------------------------------------------------------------
# 方式一：通过环境变量配置额外供应商（JSON 数组格式）
# SGA_PROVIDERS=[{"name":"deepseek","apiKey":"sk-xxx","defaultModel":"deepseek-chat"},{"name":"openai","apiKey":"sk-yyy","defaultModel":"gpt-4o"}]

# 方式二：通过配置文件配置多个供应商（推荐）
# 在项目根目录创建 sga-providers.json 文件：
# {
#   "defaultProvider": "deepseek",
#   "providers": [
#     {
#       "name": "deepseek",
#       "apiKey": "sk-xxx",
#       "defaultModel": "deepseek-chat"
#     },
#     {
#       "name": "openai",
#       "apiKey": "sk-yyy",
#       "baseUrl": "https://api.openai.com/v1",
#       "defaultModel": "gpt-4o",
#       "modelConfigs": {
#         "gpt-4o": {
#           "id": "gpt-4o",
#           "displayName": "GPT-4o",
#           "contextWindow": 128000,
#           "maxOutputTokens": 16384,
#           "supportsVision": true,
#           "supportsToolUse": true
#         }
#       }
#     },
#     {
#       "name": "anthropic",
#       "apiKey": "sk-ant-zzz",
#       "defaultModel": "sonnet"
#     }
#   ]
# }
#
# 也可以在用户主目录下创建 ~/.sga-template/providers.json（格式相同）

# 方式三：通过 API 动态添加供应商
# POST /api/v1/providers
# {
#   "name": "deepseek",
#   "apiKey": "sk-xxx",
#   "defaultModel": "deepseek-chat",
#   "setAsDefault": true
# }

# ------------------------------------------------------------
# 中转供应商 / 自定义供应商扩展
# ------------------------------------------------------------
# 对于 API 格式与官方不同的中转供应商，可以使用扩展机制：
#
# 方式一：使用请求/响应转换器（适用于 API 格式有少量差异的情况）
# {
#   "name": "my-relay",
#   "apiKey": "sk-relay-xxx",
#   "baseUrl": "https://relay.example.com/v1",
#   "defaultModel": "gpt-4o",
#   "extension": {
#     "requestTransformer": "./transformers/my-relay-request.js",
#     "responseTransformer": "./transformers/my-relay-response.js",
#     "streamChunkTransformer": "./transformers/my-relay-stream.js"
#   }
# }
#
# 转换器模块示例（./transformers/my-relay-request.js）：
# export default function transformRequest(body, headers) {
#   // 修改请求体和请求头
#   body.custom_field = "value"
#   headers["X-Custom-Auth"] = "custom-token"
#   return { body, headers }
# }
#
# 方式二：使用自定义 Provider 模块（适用于 API 格式差异较大的情况）
# {
#   "name": "my-custom-provider",
#   "apiKey": "sk-custom-xxx",
#   "baseUrl": "https://custom.example.com/api",
#   "defaultModel": "custom-model",
#   "extension": {
#     "providerModule": "./providers/my-custom-provider.js"
#   }
# }
#
# 自定义 Provider 模块示例（./providers/my-custom-provider.js）：
# export default class MyCustomProvider {
#   constructor(config) {
#     this.name = config.name
#     this.config = config
#   }
#   resolveModel(model) { return model }
#   getModelConfig(model) { return undefined }
#   validateConfig() { return !!this.config.apiKey }
#   async createMessage(options) { /* 自定义实现 */ }
#   async *createStreamingMessage(options) { /* 自定义实现 */ }
# }

# ------------------------------------------------------------
# 服务配置
# ------------------------------------------------------------
# HTTP 服务端口（默认 3000）
# PORT=3000

# HTTP 服务绑定地址（默认 0.0.0.0）
# HOST=0.0.0.0

# CORS 允许的来源（默认 *）
# CORS_ORIGIN=*

# API 认证密钥（可选，设置后请求需携带 Authorization: Bearer <key>）
# SGA_API_KEY=your-secret-key

# API 基础路径（默认 /api/v1）
# BASE_PATH=/api/v1

# SGA 数据主目录（可选，默认 ~/.sga）
# 记忆文件、供应商配置、MCP 配置、Skills 等均保存在此目录下
# SGA_HOME=~/.sga
# 配置此项，迁移完成后旧目录将被删除
# SGA_MIGRATION_CLEANUP=true

# ------------------------------------------------------------
# Web 搜索工具（可选）
# ------------------------------------------------------------
# Brave Search API 密钥
# BRAVE_SEARCH_API_KEY=xxx
# WEB_SEARCH_API_KEY=xxx

# ============================================================
# 上下文压缩配置
# ============================================================

# --- MicroCompact 微压缩（清除旧工具输出，无需 LLM） ---
# 是否启用微压缩（默认 true）
# SGA_COMPACT_MICRO_ENABLED=true
# 距上次助手消息超过多少分钟触发（默认 10）
# SGA_COMPACT_MICRO_GAP_MINUTES=10
# 保留最近 N 条工具结果（默认 3）
# SGA_COMPACT_MICRO_KEEP_RECENT=3
# 单条工具结果最大 token 数（默认 50000）
# SGA_COMPACT_MICRO_MAX_TOOL_RESULT_TOKENS=50000

# --- SessionMemoryCompact 会话记忆压缩 ---
# 触发压缩的最小 token 数（默认 10000）
# SGA_COMPACT_SM_MIN_TOKENS=10000
# 触发压缩的最小文本块消息数（默认 5）
# SGA_COMPACT_SM_MIN_TEXT_BLOCK_MESSAGES=5
# 压缩的最大 token 数（默认 40000）
# SGA_COMPACT_SM_MAX_TOKENS=40000
# 会话记忆摘要最大 token 数（默认 30000）
# SGA_COMPACT_SM_MAX_SESSION_MEMORY_TOKENS=30000

# --- FullCompact 全量压缩（LLM 摘要生成） ---
# 是否启用全量压缩（默认 true）
# SGA_COMPACT_FULL_ENABLED=true
# LLM 摘要最大输出 token 数（默认 20000）
# SGA_COMPACT_FULL_MAX_OUTPUT_TOKENS=20000
# Prompt Too Long 重试次数（默认 3）
# SGA_COMPACT_FULL_MAX_PTL_RETRIES=3
# 压缩前保留的缓冲 token 数（默认 13000）
# SGA_COMPACT_FULL_BUFFER_TOKENS=13000
# token 警告阈值（默认 20000）
# SGA_COMPACT_FULL_WARNING_THRESHOLD_TOKENS=20000
# 连续失败最大次数（默认 3）
# SGA_COMPACT_FULL_MAX_CONSECUTIVE_FAILURES=3

# --- 自动压缩通用 ---
# 模型上下文窗口最大 token 数（默认 200000）
# 重要：根据你使用的模型调整此值，如 GPT-4o 设为 128000，Claude Haiku 设为 200000
# SGA_MODEL_MAX_TOKENS=200000
# 是否优先使用会话记忆压缩（默认 true）
# SGA_COMPACT_PREFER_SESSION_MEMORY=true

# ============================================================
# 记忆整合（AutoDream）配置
# ============================================================
# 是否启用记忆整合（默认 true）
# SGA_CONSOLIDATION_ENABLED=true
# 距上次整合至少多少小时（默认 24）
# SGA_CONSOLIDATION_MIN_HOURS=24
# 至少有多少新会话才触发整合（默认 5）
# SGA_CONSOLIDATION_MIN_SESSIONS=5
# 整合 LLM 最大输出 token 数（默认 16000）
# SGA_CONSOLIDATION_MAX_OUTPUT_TOKENS=16000
# 整合使用的模型别名（默认 haiku）
# SGA_CONSOLIDATION_MODEL=haiku
# 整合锁过期时间（毫秒，默认 3600000 = 1小时）
# SGA_CONSOLIDATION_LOCK_STALE_MS=3600000
# 整合扫描间隔（毫秒，默认 600000 = 10分钟）
# SGA_CONSOLIDATION_SCAN_INTERVAL_MS=600000

# ============================================================
# 上下文预算配置
# ============================================================
# 上下文窗口最大 token 数（默认 200000）
# 重要：应与 SGA_MODEL_MAX_TOKENS 保持一致
# SGA_BUDGET_MAX_CONTEXT_TOKENS=200000
# 系统指令预留 token 数（默认 4000）
# SGA_BUDGET_RESERVED_SYSTEM_TOKENS=4000
# 对话预留 token 数（默认 50000）
# SGA_BUDGET_RESERVED_CONVERSATION_TOKENS=50000
# 工具预留 token 数（默认 10000）
# SGA_BUDGET_RESERVED_TOOLS_TOKENS=10000
# 记忆预算占比（默认 0.25）
# SGA_BUDGET_MEMORY_RATIO=0.25
# 工作集预算占比（默认 0.15）
# SGA_BUDGET_WORKING_SET_RATIO=0.15
# 压缩触发阈值（默认 0.85，即使用 85% 时触发）
# SGA_BUDGET_COMPRESSION_THRESHOLD=0.85

# ============================================================
# 工作集（WorkingSet）配置
# ============================================================
# 最大锚点数量（默认 5）
# SGA_WORKING_SET_MAX_ANCHORS=5
# 锚点淡出时间（毫秒，默认 300000 = 5分钟）
# SGA_WORKING_SET_ANCHOR_FADE_MS=300000
# 锚点过期时间（毫秒，默认 900000 = 15分钟）
# SGA_WORKING_SET_ANCHOR_EXPIRE_MS=900000
# 单个锚点最大 token 数（默认 8000）
# SGA_WORKING_SET_MAX_ANCHOR_TOKENS=8000
# 自动固定阈值（访问次数，默认 3）
# SGA_WORKING_SET_AUTO_PIN_THRESHOLD=3
# 淡出时是否生成摘要（默认 true）
# SGA_WORKING_SET_SUMMARY_ON_FADE=true

# ============================================================
# 压缩后状态恢复配置
# ============================================================
# 恢复的最大文件数（默认 5）
# SGA_POST_COMPACT_MAX_FILES=5
# 恢复的总 token 预算（默认 50000）
# SGA_POST_COMPACT_TOKEN_BUDGET=50000
# 单文件最大恢复 token 数（默认 5000）
# SGA_POST_COMPACT_MAX_TOKENS_PER_FILE=5000
# 单技能最大恢复 token 数（默认 5000）
# SGA_POST_COMPACT_MAX_TOKENS_PER_SKILL=5000
# 技能恢复总 token 预算（默认 25000）
# SGA_POST_COMPACT_SKILLS_TOKEN_BUDGET=25000

# ============================================================
# 熔断器配置
# ============================================================
# 压缩熔断器：连续失败次数（默认 3）
# SGA_CB_COMPACT_MAX_FAILURES=3
# 压缩熔断器：冷却时间（毫秒，默认 300000 = 5分钟）
# SGA_CB_COMPACT_COOLDOWN_MS=300000
# 压缩熔断器：半开状态最大尝试次数（默认 1）
# SGA_CB_COMPACT_HALF_OPEN_ATTEMPTS=1
# 整合熔断器：连续失败次数（默认 2）
# SGA_CB_CONSOLIDATION_MAX_FAILURES=2
# 整合熔断器：冷却时间（毫秒，默认 1800000 = 30分钟）
# SGA_CB_CONSOLIDATION_COOLDOWN_MS=1800000
# 整合熔断器：半开状态最大尝试次数（默认 1）
# SGA_CB_CONSOLIDATION_HALF_OPEN_ATTEMPTS=1

# ============================================================
# 工具调用摘要配置
# ============================================================
# 是否启用工具调用摘要（默认 true）
# SGA_TOOL_SUMMARY_ENABLED=true
# 生成摘要使用的模型（默认 haiku）
# SGA_TOOL_SUMMARY_MODEL=haiku
# 工具输入最大长度（默认 300）
# SGA_TOOL_SUMMARY_MAX_INPUT_LENGTH=300
# 工具输出最大长度（默认 300）
# SGA_TOOL_SUMMARY_MAX_OUTPUT_LENGTH=300
# 摘要最大长度（默认 60）
# SGA_TOOL_SUMMARY_MAX_SUMMARY_LENGTH=60

# ============================================================
# 团队记忆同步配置
# ============================================================
# 是否启用团队记忆同步（默认 true）
# SGA_TEAM_SYNC_ENABLED=true
# 同步间隔（毫秒，默认 30000 = 30秒）
# SGA_TEAM_SYNC_INTERVAL_MS=30000
# 每次同步最大条目数（默认 50）
# SGA_TEAM_SYNC_MAX_ENTRIES=50
# 冲突解决策略：last_write_wins / merge / manual（默认 last_write_wins）
# SGA_TEAM_SYNC_CONFLICT_RESOLUTION=last_write_wins

# ============================================================
# 思考力度（Thinking Effort）配置
# ============================================================
# 默认思考力度：low / medium / high / max（默认 medium）
# low: 快速响应，较少思考
# medium: 平衡模式
# high: 深度思考，更全面的分析
# max: 最大思考力度，最详细的推理
# SGA_THINKING_EFFORT_DEFAULT=medium

# Anthropic Claude 原生思考预算（token 数）
# SGA_THINKING_EFFORT_BUDGET_LOW=2000
# SGA_THINKING_EFFORT_BUDGET_MEDIUM=10000
# SGA_THINKING_EFFORT_BUDGET_HIGH=20000
# SGA_THINKING_EFFORT_BUDGET_MAX=32000

# 是否对不支持原生思考的模型启用提示词注入模拟（默认 true）
# 启用后，GPT-4o、DeepSeek 等模型也会通过系统提示词获得思考力度控制
# SGA_THINKING_EFFORT_PROMPT_INJECTION=true

# 是否在提示词注入中使用 Chain-of-Thought 格式（默认 true）
# 仅在 high/max 级别时生效，使用 <thinking> 标签引导模型展示推理过程
# SGA_THINKING_EFFORT_COT=true
