{
  "name": "cc-contron",
  "version": "1.0.0",
  "description": "A reusable Agent framework extracted from Claude Code, supporting multi-agent orchestration, memory, skills, and more.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --loader ts-node/esm src/server/main.ts",
    "start:dist": "node dist/server/main.js",
    "dev": "node --loader ts-node/esm --watch src/server/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": ">=0.80.0",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "p-map": "^7.0.4",
    "picomatch": "^4.0.4",
    "proper-lockfile": "^4.1.2",
    "uuid": "^10.0.0",
    "yaml": "^2.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.80.0"
  },
  "keywords": [
    "agent",
    "ai",
    "framework",
    "multi-agent",
    "llm",
    "claude"
  ],
  "license": "MIT"
}
